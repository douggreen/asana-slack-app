# Slack Bot Configuration (Required)
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-level-token-here

# Asana API Configuration (Optional - enables rich task details)
ASANA_ACCESS_TOKEN=

# Display Configuration (Optional - defaults to showing all fields)
# Options: link, completed, assignee, due_on, projects
# Examples:
#   Show all fields (default):
#     DISPLAY=ticket,link,completed,assignee,due_on,projects
#   Show only link:
#     DISPLAY=link
#   Show link and assignee only:
#     DISPLAY=link,assignee
# DISPLAY=ticket,link,completed,assignee,due_on,projects

# Test Channel (Optional - bot will post startup message here)
# TEST_CHANNEL_ID=
