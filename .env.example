# Slack Bot Configuration (Socket Mode)
# Get these from https://api.slack.com/apps

# Your Bot User OAuth Token (starts with xoxb-)
# Found in: OAuth & Permissions page
SLACK_BOT_TOKEN=xoxb-your-token-here

# Your App-Level Token (starts with xapp-)
# Found in: Basic Information > App-Level Tokens
# Required scope: connections:write
SLACK_APP_TOKEN=xapp-your-app-token-here

# Optional: Channel ID for startup test message
# To get channel ID: Right-click channel > View channel details > Copy ID (at bottom)
# Leave blank to skip startup message
TEST_CHANNEL_ID=

# Optional: Asana Personal Access Token (for enhanced version with task details)
# To get token: https://app.asana.com/0/my-apps
# Leave blank to just show links without task details
ASANA_ACCESS_TOKEN=
